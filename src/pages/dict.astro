---
import Base from '../layouts/Base.astro';
import { terms, getSegment } from '../lib/data';
---

<Base title="名相詞典" current="dict">
  <header class="read-head">
    <h1 class="read-title">名相詞典</h1>
    <p class="read-lb-range">本觀常用名相，依拼音排序。</p>
  </header>

  {terms.map((t) => (
    <article class="term-card" id={t.id}>
      <h3>{t.term}<span class="pinyin">{t.pinyin}</span></h3>
      <p class="def">{t.def}</p>
      <p class="refs">
        出處：
        {t.refs.map((r, i) => (
          <>
            {i > 0 && '、'}
            <a href={`/read/${r}`}>{getSegment(r)?.title ?? r}</a>
          </>
        ))}
      </p>
    </article>
  ))}
</Base>
