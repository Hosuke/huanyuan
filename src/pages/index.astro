---
import Base from '../layouts/Base.astro';
import OutlineTree from '../components/OutlineTree.astro';
import { data } from '../lib/data';
---

<Base title="總綱" wide current="home">
  <header class="read-head">
    <p class="read-part">{data.cbeta}・{data.author}</p>
    <h1 class="read-title">{data.sutra}</h1>
    <p class="read-lb-range">
      一體、二用、三遍、四德、五止、六觀——點擊節點進入對應段落。
    </p>
  </header>
  <OutlineTree />
</Base>
