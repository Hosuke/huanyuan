---
import Base from '../../layouts/Base.astro';
import SegmentText from '../../components/SegmentText.astro';
import ReadToggle from '../../components/ReadToggle.astro';
import { data, segments, formatLb, base, type Segment } from '../../lib/data';

export function getStaticPaths() {
  return segments.map((seg, i) => ({
    params: { id: seg.id },
    props: {
      seg,
      prev: i > 0 ? segments[i - 1] : null,
      next: i < segments.length - 1 ? segments[i + 1] : null,
    },
  }));
}

interface Props {
  seg: Segment;
  prev: Segment | null;
  next: Segment | null;
}

const { seg, prev, next } = Astro.props;

const commentaries = [
  { key: 'baihua', label: '白話' },
  { key: 'tifo', label: '體佛法師' },
  { key: 'jingkong', label: '淨空法師' },
  { key: 'mengcan', label: '夢參法師' },
] as const;
---

<Base title={`${seg.id} ${seg.title}`}>
  <header class="read-head">
    <p class="read-part">{seg.part_name}・{seg.id}</p>
    <h1 class="read-title">{seg.title}</h1>
    <p class="read-lb-range">
      {data.cbeta} {formatLb(seg.start_lb)}–{formatLb(seg.end_lb)}
    </p>
  </header>

  <SegmentText seg={seg} />

  <section class="tabs">
    <div class="tab-bar" role="tablist">
      {commentaries.map((c, i) => (
        <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={c.key}>
          {c.label}
        </button>
      ))}
    </div>

    <div class="tab-panel" data-panel="baihua" role="tabpanel">
      {seg.translation
        ? <p>{seg.translation}</p>
        : <p class="placeholder">整理中，敬請期待</p>}
    </div>

    {(['tifo', 'jingkong', 'mengcan'] as const).map((key) => {
      const c = seg.commentaries[key];
      return (
        <div class="tab-panel" data-panel={key} role="tabpanel" hidden>
          {c.status === 'pending'
            ? <p class="placeholder">整理中，敬請期待</p>
            : <p>{c.notes}</p>}
        </div>
      );
    })}
  </section>

  <div style="margin-top: 2.5rem; text-align: center;">
    <ReadToggle id={seg.id} />
  </div>

  <nav class="read-nav">
    <span>
      {prev && <a href={`${base}/read/${prev.id}`}>← {prev.title}</a>}
    </span>
    <a href={base}>返回總綱</a>
    <span>
      {next && <a href={`${base}/read/${next.id}`}>{next.title} →</a>}
    </span>
  </nav>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tab"]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach((p) => {
        p.hidden = p.getAttribute('data-panel') !== tab.getAttribute('data-tab');
      });
    });
  });
</script>
