---
import Base from '../../layouts/Base.astro';
import AnnotatedText from '../../components/AnnotatedText.astro';
import {
  base,
  cbetaUrl,
  commentaryMeta,
  data,
  formatCbetaRef,
  formatEpisodes,
  formatLb,
  gates,
  plainText,
  quotesBySegment,
  segments,
  shortTitle,
  taixuSegmentUrl,
  taixuUrl,
  termsBySegment,
  variantsBySegment,
  type Commentary,
  type Segment,
} from '../../lib/data';

export function getStaticPaths() {
  return segments.map((seg, i) => ({
    params: { id: seg.id },
    props: {
      seg,
      prev: i > 0 ? segments[i - 1] : null,
      next: i < segments.length - 1 ? segments[i + 1] : null,
    },
  }));
}

interface Props {
  seg: Segment;
  prev: Segment | null;
  next: Segment | null;
}

const { seg, prev, next } = Astro.props as Props;
const gate = gates.find((g) => g.part === seg.part);
const quotes = quotesBySegment(seg.id);
const terms = termsBySegment(seg.id);
const variants = variantsBySegment(seg.id);
const plain = plainText(seg);
const originalUrl = taixuSegmentUrl(seg.id);
const placed = (needle: string) => !!needle && plain.includes(needle);

interface NotePoint {
  text: string;
  source: string;
}

interface ParsedNotes {
  summary: string;
  points: NotePoint[];
  caveat?: string;
}

/** 講記摘要須整體符合約定格式才結構化；任一異常皆安全回退為純文字。 */
function parseNotes(notes: string): ParsedNotes | undefined {
  const blocks = notes.replace(/\r\n?/g, '\n').trim().split(/\n\s*\n/);
  if (blocks.length < 2) return undefined;
  const summary = blocks.shift()?.trim() ?? '';
  if (!summary || summary.startsWith('· ')) return undefined;
  const points: NotePoint[] = [];
  let caveat: string | undefined;
  for (const line of blocks.join('\n').split('\n').map((l) => l.trim()).filter(Boolean)) {
    const m = /^·\s+(.+?)【([^【】]+)】$/.exec(line);
    if (m) {
      points.push({ text: m[1], source: m[2] });
      continue;
    }
    const c = /^（整理(?:說明|说明)：(.+)）$/.exec(line);
    if (c && caveat === undefined) {
      caveat = c[1];
      continue;
    }
    return undefined;
  }
  return points.length ? { summary, points, caveat } : undefined;
}

/** 講記出處：淨空按檔名歸組；體佛講義記作 tifo-NNN。 */
function episodesLabel(key: string, eps: string[]): string {
  if (key === 'tifo') {
    const nums = [...new Set(eps.map((e) => Number.parseInt(e.replace(/^tifo-/, ''), 10)).filter(Number.isFinite))]
      .sort((a, b) => a - b);
    const ranges: string[] = [];
    for (let i = 0; i < nums.length; i++) {
      const start = nums[i];
      while (i + 1 < nums.length && nums[i + 1] === nums[i] + 1) i++;
      const end = nums[i];
      ranges.push(start === end ? `${start}` : `${start}–${end}`);
    }
    return `體佛法師《修華嚴奧旨妄盡還源觀》講義 第 ${ranges.join('、')} 集`;
  }
  return formatEpisodes(eps);
}

const pendingNote: Record<string, string> = {
  tifo: '體佛法師講義未講此段（宋淨源後序不在講述範圍）。',
  jingkong: '本段淨空法師講記摘要整理中。',
};

const voices = commentaryMeta.map(({ key, label }) => {
  const c: Commentary = seg.commentaries[key];
  const ready = c.status !== 'pending' && !!c.notes;
  return { key, label, c, ready, parsed: ready ? parseNotes(c.notes) : undefined };
});

const tabs = [
  { key: 'baihua', label: '白話', ready: !!seg.translation, count: 0 },
  ...voices.map((v) => ({ key: v.key, label: v.label, ready: v.ready, count: v.parsed?.points.length ?? 0 })),
];

const partSegs = data.parts.map((part) => ({
  part,
  name: gates.find((g) => g.part === part.part)?.full ?? part.name,
  segs: segments.filter((s) => s.part === part.part),
}));
---

<Base title={`${seg.id} ${seg.title}`} wide>
  <div class="scroll-meter" aria-hidden="true"><span data-scroll-meter></span></div>

  <div class="reader" data-reader data-id={seg.id} data-prev={prev?.id} data-next={next?.id}>
    <nav class="toc" aria-label="全篇目次" data-toc>
      <div class="toc-head"><span>目次</span><a href={`${base}/`}>總綱 ↗</a></div>
      {partSegs.map(({ name, segs }) => (
        <>
          <div class="toc-part">{name}</div>
          <ol>
            {segs.map((s) => (
              <li>
                <a href={`${base}/read/${s.id}`} data-seg={s.id} aria-current={s.id === seg.id ? 'page' : undefined}>
                  {shortTitle(s)}
                  <span class="sc-dot" aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ol>
        </>
      ))}
    </nav>

    <article class="reader-main">
      <header class="read-head">
        <p class="kicker">{gate ? gate.full : seg.part_name}・{seg.id}</p>
        <h1>{seg.title}</h1>
        <div class="read-meta">
          <span class="lbr">{data.cbeta} {formatLb(seg.start_lb)}–{formatLb(seg.end_lb)}</span>
          <span>{plain.length} 字</span>
          <a href={`${base}/full#s-${seg.id}`}>於通讀中查看</a>
          {originalUrl && <a href={originalUrl} target="_blank" rel="noopener">於太虛間查看原文 ↗</a>}
        </div>
      </header>

      <div class="reading-tools">
        <button class="chip-toggle toc-toggle" type="button" data-toc-toggle aria-expanded="false">☰ 目次</button>
        <button class="chip-toggle" type="button" data-toggle-pref="parallel:on:off" aria-pressed="false">白話並列</button>
        <button class="chip-toggle" type="button" data-toggle-pref="writing:v:h" aria-pressed="false">直排</button>
        <button class="chip-toggle" type="button" data-toggle-pref="lb:on:off" aria-pressed="false">行號</button>
        <span class="legend-inline" aria-hidden="true">
          {terms.length > 0 && <span class="lg-term">名相</span>}
          {quotes.length > 0 && <span class="lg-quote">徵引</span>}
          {variants.length > 0 && <span class="lg-var">校勘</span>}
        </span>
      </div>

      <div class="text-stage">
        <section class="parallel-col" aria-label="原文">
          <h2 class="visually-hidden">原文</h2>
          <div class="sutra-wrap" data-sutra-wrap>
            <AnnotatedText seg={seg} />
          </div>
        </section>
        <section class="parallel-col parallel-only" aria-label="白話並列">
          <h2>白話試譯</h2>
          <p class="translation">{seg.translation}</p>
        </section>
      </div>

      <section class="commentary" id="commentary" aria-label="白話與講記">
        <div class="tab-bar" role="tablist">
          {tabs.map((t) => (
            <button
              id={`tab-${t.key}`}
              type="button"
              role="tab"
              class:list={{ 'is-empty': !t.ready }}
              aria-controls={`panel-${t.key}`}
              aria-selected="false"
              tabindex="-1"
              data-tab={t.key}
            >
              {t.label}
              {t.count > 0 && <span class="badge">{t.count}</span>}
            </button>
          ))}
        </div>

        <div class="tab-panel" id="panel-baihua" role="tabpanel" aria-labelledby="tab-baihua" data-panel="baihua" hidden>
          {seg.translation
            ? (
              <>
                <p class="translation translation-panel">{seg.translation}</p>
                <p class="provenance">白話為本站試譯（未經法師審定），僅供學習參考。</p>
              </>
            )
            : <p class="placeholder">白話整理中。</p>}
        </div>

        {voices.map((v) => (
          <div class="tab-panel" id={`panel-${v.key}`} role="tabpanel" aria-labelledby={`tab-${v.key}`} data-panel={v.key} hidden>
            {!v.ready
              ? <p class="placeholder">{pendingNote[v.key]}</p>
              : (
                <>
                  {v.c.episodes.length > 0 && <p class="eps">出處：{episodesLabel(v.key, v.c.episodes)}</p>}
                  {v.key === 'tifo' && v.c.episodes.length > 0 && (
                    <p class="lecture-links">
                      講義原文：{v.c.episodes.map((episode, i) => {
                        const n = Number.parseInt(episode.replace(/^tifo-/, ''), 10);
                        return <>{i > 0 && '、'}<a href={`${base}/tifo/${String(n).padStart(2, '0')}`}>第 {n} 集</a></>;
                      })}
                    </p>
                  )}
                  {v.parsed
                    ? (
                      <div class="notes-structured">
                        <p class="notes-summary">{v.parsed.summary}</p>
                        <ol class="points">
                          {v.parsed.points.map((pt) => (
                            <li>{pt.text}<span class="src">{pt.source}</span></li>
                          ))}
                        </ol>
                        {v.parsed.caveat && <p class="caveat">整理說明：{v.parsed.caveat}</p>}
                      </div>
                    )
                    : <div class="notes">{v.c.notes}</div>}
                  <p class="provenance">講記為本站學習摘要，非講者原文；完整內容請參原講。</p>
                </>
              )}
          </div>
        ))}
      </section>

      <div class="read-end">
        <button class="btn-read" type="button" data-read-toggle aria-pressed="false">標記已讀</button>
      </div>

      <nav class="pager" aria-label="上下段">
        {prev && (
          <a class="prev" href={`${base}/read/${prev.id}`} rel="prev">
            <span class="dir">← 上一段・{prev.id}</span>{prev.title}
          </a>
        )}
        {next && (
          <a class="next" href={`${base}/read/${next.id}`} rel="next">
            <span class="dir">下一段・{next.id} →</span>{next.title}
          </a>
        )}
      </nav>
    </article>

    <aside class="margin" aria-label="本段旁註">
      <div class="margin-grid">
        {terms.length > 0 && (
          <section class="margin-sec">
            <h2>名相 <a href={`${base}/dict`}>詞典</a></h2>
            {terms.map((t) => (
              <div class="note-card term" id={`n-term-${t.id}`} data-card-term={t.id} tabindex="0">
                <span class="nc-title">{t.term}</span>
                <span class="nc-sub">{t.pinyin}</span>
                <span class="nc-body">{t.def}</span>
                {!placed(t.term) && <span class="unplaced">（本段未直出此詞）</span>}
                <a class="pop-link" href={`${base}/dict#${t.id}`} hidden>詞典條目 →</a>
              </div>
            ))}
          </section>
        )}

        {quotes.length > 0 && (
          <section class="margin-sec">
            <h2>徵引</h2>
            {quotes.map((q) => {
              const identified = [q.identified.juan, q.identified.pin].filter(Boolean);
              const statusLabel = {
                identified: '',
                paraphrase: '・義引',
                unlocated: '・原典未詳',
                general: '・泛指',
                pending: '・出處待考',
              }[q.status];
              const ref = q.identified.cbeta_ref;
              const showQuote = q.quote && !(q.status === 'general' && q.quote === '也');
              return (
                <div class="note-card quote" id={`n-quote-${q.id}`} data-card-quote={q.id} tabindex="0">
                  <span class="nc-title">《{q.work}》</span>
                  <span class="nc-sub">
                    {q.cited_as !== q.work ? `文中稱「${q.cited_as}」` : '文中直引'}
                    {statusLabel}
                    {identified.length > 0 ? `・${identified.join('・')}` : ''}
                  </span>
                  {showQuote && <span class="nc-body">{q.quote.length > 60 ? `${q.quote.slice(0, 60)}……` : q.quote}</span>}
                  {ref && <span class="nc-src">{q.identified.canon}{q.identified.juan}・{formatCbetaRef(ref)}</span>}
                  {q.note && <span class="nc-note">{q.note}</span>}
                  {(ref || q.taixu) && (
                    <span class="nc-links">
                      {q.taixu && <a class="src-link primary" href={taixuUrl(q.taixu, q.taixu_hl)} target="_blank" rel="noopener">太虛間原文 ↗</a>}
                      {ref && <a class="src-link" href={cbetaUrl(ref)} target="_blank" rel="noopener">CBETA ↗</a>}
                    </span>
                  )}
                </div>
              );
            })}
          </section>
        )}

        {variants.length > 0 && (
          <section class="margin-sec">
            <h2>校勘 <a href={`${base}/collation`}>全表</a></h2>
            {variants.map(({ index, variant }) => (
              <div class="note-card variant" id={`n-var-${index}`} data-card-variant={index} tabindex="0">
                <span class="nc-title">
                  {variant.cbeta || '（無）'} ／ {variant.wikisource || '（無）'}
                </span>
                <span class="nc-sub">{formatLb(variant.lb)}・底本／維基文庫本・{variant.ruling}</span>
                {variant.note && <span class="nc-body">{variant.note}</span>}
                <a class="pop-link" href={`${base}/collation#v-${index}`} hidden>校勘記 →</a>
              </div>
            ))}
          </section>
        )}

        {terms.length + quotes.length + variants.length === 0 && (
          <section class="margin-sec">
            <h2>旁註</h2>
            <p class="muted" style="font-size: 0.82rem;">本段暫無名相、徵引與校勘條目。</p>
          </section>
        )}
      </div>
    </aside>
  </div>

  <div class="pop" role="dialog" aria-modal="false" data-pop hidden>
    <button class="pop-close" type="button" aria-label="關閉" data-pop-close>×</button>
    <div class="pop-kind" data-pop-kind></div>
    <div data-pop-body></div>
  </div>
</Base>

<script>
  import '../../scripts/reader';
</script>
