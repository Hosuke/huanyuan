---
import '../styles/global.css';
import { PREFS_STORAGE_KEY, base } from '../lib/data';

interface Props {
  title: string;
  wide?: boolean;
  current?: 'home' | 'full' | 'dict' | 'collation' | 'about';
  description?: string;
}

const { title, wide = false, current, description = '華嚴宗《修華嚴奧旨妄盡還源觀》互動課本：原文、白話、講記、名相與校勘對讀。' } = Astro.props;
const fullTitle = `${title}｜修華嚴奧旨妄盡還源觀`;

const nav = [
  { key: 'home', href: `${base}/`, label: '總綱' },
  { key: 'full', href: `${base}/full`, label: '通讀' },
  { key: 'dict', href: `${base}/dict`, label: '名相' },
  { key: 'collation', href: `${base}/collation`, label: '校勘' },
  { key: 'about', href: `${base}/about`, label: '說明' },
] as const;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f6f1e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171612" media="(prefers-color-scheme: dark)" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23a23b2c'/%3E%3Ctext x='32' y='45' text-anchor='middle' font-family='serif' font-size='40' fill='white'%3E%E6%BA%90%3C/text%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600&family=LXGW+WenKai+TC&display=swap"
    />
    <script is:inline define:vars={{ key: PREFS_STORAGE_KEY }}>
      // 首屏前套用閱讀偏好，避免主題閃爍。
      try {
        const p = JSON.parse(localStorage.getItem(key) || '{}');
        const r = document.documentElement;
        if (p.theme === 'light' || p.theme === 'dark') r.dataset.theme = p.theme;
        r.dataset.size = ['s', 'm', 'l', 'xl'].includes(p.size) ? p.size : 'm';
        r.dataset.writing = p.writing === 'v' ? 'v' : 'h';
        r.dataset.lb = p.lb === 'off' ? 'off' : 'on';
        r.dataset.parallel = p.parallel === 'on' ? 'on' : 'off';
      } catch {
        /* 無痕模式或損壞資料：用預設值 */
      }
    </script>
  </head>
  <body>
    <a class="visually-hidden" href="#main">跳至正文</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={`${base}/`} aria-label="妄盡還源觀・回總綱">
          <span class="seal" aria-hidden="true">源</span>妄盡還源觀
        </a>
        <nav class="site-nav" aria-label="主導覽">
          {nav.map((item) => (
            <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="header-tools">
          <slot name="tools" />
          <button class="tool-btn search-btn" type="button" data-open-search aria-label="搜尋（快捷鍵 /）">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" stroke-linecap="round" /></svg>
            <span class="label">搜尋</span><kbd>/</kbd>
          </button>
          <button class="tool-btn icon-only" type="button" data-open-prefs aria-label="閱讀設定" aria-expanded="false" aria-controls="prefs-panel">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 6h12M4 14h12" stroke-linecap="round" /><circle cx="8" cy="6" r="2" fill="var(--bg-raised)" /><circle cx="13" cy="14" r="2" fill="var(--bg-raised)" /></svg>
          </button>
        </div>
      </div>

      <div class="prefs-panel" id="prefs-panel" role="dialog" aria-label="閱讀設定" hidden>
        <h2>閱讀設定</h2>
        <div class="pref-row">
          <span>主題</span>
          <div class="seg-control" data-pref="theme">
            <button type="button" data-value="auto">隨系統</button>
            <button type="button" data-value="light">宣紙</button>
            <button type="button" data-value="dark">墨夜</button>
          </div>
        </div>
        <div class="pref-row">
          <span>字號</span>
          <div class="seg-control" data-pref="size">
            <button type="button" data-value="s">小</button>
            <button type="button" data-value="m">中</button>
            <button type="button" data-value="l">大</button>
            <button type="button" data-value="xl">特大</button>
          </div>
        </div>
        <div class="pref-row">
          <span>原文排版</span>
          <div class="seg-control" data-pref="writing">
            <button type="button" data-value="h">橫排</button>
            <button type="button" data-value="v">直排</button>
          </div>
        </div>
        <div class="pref-row">
          <span>大正藏行號</span>
          <div class="seg-control" data-pref="lb">
            <button type="button" data-value="on">顯示</button>
            <button type="button" data-value="off">隱藏</button>
          </div>
        </div>
        <div class="pref-row">
          <span>白話對讀</span>
          <div class="seg-control" data-pref="parallel">
            <button type="button" data-value="off">分頁</button>
            <button type="button" data-value="on">並列</button>
          </div>
        </div>
        <p class="prefs-hint">
          快捷鍵：<kbd>/</kbd> 搜尋　<kbd>←</kbd><kbd>→</kbd> 上下段　<kbd>Esc</kbd> 關閉。偏好僅存於本機瀏覽器。
        </p>
      </div>
    </header>

    <main id="main">
      <div class:list={['container', { wide }]}>
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class:list={['container', { wide }]}>
        <span>原文：CBETA T45n1876（公版古籍）・本站為學習用非商業專案</span>
        <a href={`${base}/about`}>來源與授權說明</a>
      </div>
    </footer>

    <dialog class="search-dialog" data-search-dialog aria-label="全文搜尋">
      <div class="search-field">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" stroke-linecap="round" /></svg>
        <input
          type="search"
          data-search-input
          placeholder="搜原文、白話、名相、講記……"
          autocomplete="off"
          spellcheck="false"
          role="combobox"
          aria-expanded="true"
          aria-autocomplete="list"
          aria-controls="search-results"
          aria-label="搜尋關鍵字"
        />
        <button class="search-esc" type="button" data-close-search>Esc</button>
      </div>
      <ul class="search-results" id="search-results" role="listbox" data-search-results></ul>
      <div class="search-foot"><span>↑↓ 選擇</span><span>Enter 開啟</span><span>可輸入簡體，自動轉繁</span></div>
    </dialog>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
