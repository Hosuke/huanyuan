---
import '../styles/global.css';
import { base } from '../lib/data';

interface Props {
  title: string;
  wide?: boolean;
  current?: string;
}

const { title, wide = false, current } = Astro.props;
const fullTitle = `${title}｜修華嚴奧旨妄盡還源觀`;
const description = '華嚴宗《修華嚴奧旨妄盡還源觀》互動課本';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f7f3ea" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%239e3b2e'/%3E%3Ctext x='32' y='45' text-anchor='middle' font-family='serif' font-size='40' fill='white'%3E%E6%BA%90%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href={base}>妄盡還源觀</a>
        <nav class="site-nav">
          <a href={base} aria-current={current === 'home' ? 'page' : undefined}>總綱</a>
          <a href={`${base}/dict`} aria-current={current === 'dict' ? 'page' : undefined}>名相</a>
          <a href={`${base}/collation`} aria-current={current === 'collation' ? 'page' : undefined}>校勘</a>
          <a href={`${base}/about`} aria-current={current === 'about' ? 'page' : undefined}>說明</a>
        </nav>
      </div>
    </header>
    <main>
      <div class:list={['container', { wide }]}>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        原文出處：CBETA 電子佛典 T45n1876（公版古籍）｜本站為學習用非商業專案｜
        <a href={`${base}/about`}>版權與授權說明</a>
      </div>
    </footer>
  </body>
</html>
